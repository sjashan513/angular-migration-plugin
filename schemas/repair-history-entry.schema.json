        "entrySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  ],
  "definitions": {
    "contextIssuedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedPaths", "diagnosticSummary", "logFiles"],
      "properties": {
        "allowedPaths": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "diagnosticSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "logFiles": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "submissionReceivedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["submissionSha256", "declaredRootCause", "declaredChanges"],
      "properties": {
        "submissionSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "declaredRootCause": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "declaredChanges": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "summary"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 500 },
              "summary": { "type": "string", "minLength": 1, "maxLength": 2000 }
            }
          }
        }
      }
    },
    "submissionRejectedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "changedPaths",
        "scopeViolation",
        "rollbackStatus"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_json",
            "submission_path_invalid",
            "repair_schema_invalid",
            "repair_context_invalid",
            "repair_head_changed",
            "repair_diff_mismatch",
            "repair_scope_violation",
            "repair_mode_invalid",
            "protected_file_changed",
            "repair_runtime_changed",
            "repair_evidence_invalid",
            "repair_attempts_exhausted",
            "repair_submission_sensitive",
            "repair_archive_failed",
            "repair_stage_invalid",
            "repair_history_state_mismatch",
            "repair_history_write_failed",
            "repair_history_corrupt",
            "repair_rejected"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "changedPaths": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "scopeViolation": { "type": "boolean" },
        "rollbackStatus": {
          "type": "string",
          "enum": ["passed", "failed", "not-required"]
        }
      }
    },
    "submissionAcceptedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report", "reportSha256", "commit", "changedPaths"],
      "properties": {
        "report": { "type": "string", "minLength": 1, "maxLength": 500 },
        "reportSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "commit": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" },
        "changedPaths": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "verificationFailedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkId",
        "exitCode",
        "timedOut",
        "diagnosticSummary",
        "logFiles",
        "nextAttempt",
        "sameFingerprint"
      ],
      "properties": {
        "checkId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "exitCode": { "type": "integer" },
        "timedOut": { "type": "boolean" },
        "diagnosticSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "logFiles": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "nextAttempt": { "type": "integer", "minimum": 1, "maximum": 3 },
        "sameFingerprint": { "type": "boolean" },
        "newFingerprint": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "verificationPassedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkId",
        "exitCode",
        "timedOut",
        "resultLogFiles",
        "verifiedCommit"
      ],
      "properties": {
        "checkId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "exitCode": { "type": "integer" },
        "timedOut": { "type": "boolean" },
        "resultLogFiles": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "verifiedCommit": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" }
      }
    },
    "attemptsExhaustedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "scope", "nextAction"],
      "properties": {
        "limit": { "type": "integer", "enum": [3, 5] },
        "scope": { "type": "string", "enum": ["fingerprint", "run"] },
        "nextAction": { "type": "string", "enum": ["human-review"] }
      }
    }
  }
}
