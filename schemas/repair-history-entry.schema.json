        "failedCheck": { "type": "string", "minLength": 1, "maxLength": 200 },
        "checkpointCommit": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40}$"
        },
        "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "data": { "$ref": "#/definitions/contextIssuedData" },
        "entrySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
