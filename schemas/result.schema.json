{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sjashan513.github.io/angular-migration-plugin/schemas/result.schema.json",
  "title": "Angular migration result v5",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "sourceMajor",
    "targetMajor",
    "status",
    "migrationStatus",
    "documentationStatus",
    "manifestSha256",
    "initialCommit",
    "finalTechnicalCommit",
    "changedFiles",
    "dependencyChanges",
    "checks",
    "repairs",
    "warnings",
    "verifiedAt",
    "resultSha256"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [5] },
    "runId": { "type": "string", "minLength": 1 },
    "sourceMajor": { "type": "integer", "minimum": 0 },
    "targetMajor": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["verified"] },
    "migrationStatus": {
      "type": "string",
      "enum": ["pending", "running", "verified", "failed", "blocked"]
    },
    "documentationStatus": {
      "type": "string",
      "enum": ["pending", "researching", "completed", "failed"]
    },
    "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "initialCommit": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" },
    "finalTechnicalCommit": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{40}$"
    },
    "changedFiles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "dependencyChanges": {
      "type": "array",
      "items": { "$ref": "change-set.schema.json" }
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "check-result.schema.json" }
    },
    "skippedChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "checkId",
          "reason",
          "diagnostic",
          "approvedAt",
          "confirmed"
        ],
        "properties": {
          "stage": { "const": "baseline" },
          "checkId": { "enum": ["typecheck", "lint", "unit-test", "e2e"] },
          "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "diagnostic": {
            "type": "object",
            "required": ["code", "message", "details"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1 },
              "details": {}
            },
            "additionalProperties": false
          },
          "approvedAt": { "type": "string", "format": "date-time" },
          "confirmed": { "const": true }
        },
        "additionalProperties": false
      }
    },
    "repairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fingerprint",
          "attempt",
          "commit",
          "report",
          "reportSha256"
        ],
        "properties": {
          "fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "attempt": { "type": "integer", "minimum": 1 },
          "commit": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" },
          "report": { "type": "string", "minLength": 1 },
          "reportSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["code", "package", "peer", "range"],
            "properties": {
              "code": { "const": "optional_peer_missing" },
              "package": { "type": "string", "minLength": 1 },
              "peer": { "type": "string", "minLength": 1 },
              "range": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["code", "package", "fromMajor", "toMajor"],
            "properties": {
              "code": { "const": "package_major_changed_for_angular" },
              "package": { "type": "string", "minLength": 1 },
              "fromMajor": { "type": "integer", "minimum": 0 },
              "toMajor": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["code", "package", "version", "reason"],
            "properties": {
              "code": { "const": "deprecated_ordinary_dependency" },
              "package": { "type": "string", "minLength": 1 },
              "version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "reason": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["code", "package", "peer", "range", "reason"],
            "properties": {
              "code": { "const": "ignored_peer_dependency" },
              "package": { "type": "string", "minLength": 1 },
              "peer": { "type": "string", "minLength": 1 },
              "range": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "resultSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
