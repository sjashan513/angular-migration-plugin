{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sjashan513.github.io/angular-migration-plugin/schemas/repair-history-entry.schema.json",
  "title": "Angular migration repair history entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sequence",
    "entryId",
    "runId",
    "fingerprint",
    "attempt",
    "type",
    "timestamp",
    "stage",
    "failedCheck",
    "checkpointCommit",
    "manifestSha256",
    "data",
    "entrySha256"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "entryId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "runId": { "type": "string", "pattern": "^[a-z0-9TZ]+(?:-[a-z0-9TZ]+)*$" },
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
    "type": {
      "type": "string",
      "enum": [
        "context-issued",
        "submission-received",
        "submission-rejected",
        "submission-accepted",
        "verification-failed",
        "verification-passed",
        "attempts-exhausted"
      ]
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "stage": { "type": "string", "enum": ["validate", "update-angular"] },
    "failedCheck": { "type": "string", "minLength": 1, "maxLength": 200 },
    "checkpointCommit": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" },
    "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "data": { "type": "object" },
    "entrySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
