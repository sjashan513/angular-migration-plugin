{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Angular view capture manifest",
  "type": "object",
  "required": ["routes"],
  "properties": {
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "pattern": "^/" },
          "status": { "type": "string", "enum": ["visitable", "blocked"] },
          "reason": { "type": "string" }
        }
      }
    },
    "viewports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "width", "height"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "masks": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
