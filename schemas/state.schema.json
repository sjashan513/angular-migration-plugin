{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sjashan513.github.io/angular-migration-plugin/schemas/state.schema.json",
  "title": "Angular migration state v5",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "projectRoot",
    "sourceMajor",
    "targetMajor",
    "status",
    "stage",
    "stageRevision",
    "attempt",
    "migrationStatus",
    "documentationStatus",
    "documentation",
    "baselineStatus",
    "resolutionStatus",
    "initialBranch",
    "initialCommit",
    "migrationBranch",
    "checkpointCommit",
    "manifestSha256",
    "discoverySha256",
    "inputFingerprint",
    "runtimePlan",
    "runtimeFnmPath",
    "activeOperation",
    "completedOperations",
    "skippedChecks",
    "lastDiagnostic",
    "repair",
    "repairTotal",
    "repairs",
    "validationResults",
    "angularCommandIndex",
    "runtimeSha256",
    "configRepairAllowed",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 5 },
    "runId": { "type": "string", "pattern": "^[a-z0-9TZ]+(?:-[a-z0-9TZ]+)*$" },
    "projectRoot": { "type": "string", "minLength": 1 },
    "sourceMajor": { "type": "integer", "minimum": 0 },
    "targetMajor": { "type": "integer", "minimum": 1 },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "needs-repair",
        "verified",
        "completed",
        "blocked",
        "failed"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "baseline",
        "resolve",
        "update-angular",
        "update-dependencies",
        "install",
        "validate",
        "document",
        "done"
      ]
    },
    "stageRevision": { "type": "integer", "minimum": 0 },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
    "migrationStatus": {
      "type": "string",
      "enum": ["running", "verified", "blocked", "failed"]
    },
    "documentationStatus": {
      "type": "string",
      "enum": [
        "pending",
        "researching",
        "researched",
        "publishing",
        "completed",
        "failed"
      ]
    },
    "documentation": {
      "type": "object",
      "required": [
        "status",
        "phase",
        "researchSha256",
        "researchCommit",
        "publishAttempt",
        "publishedCommit",
        "completedAt",
        "lastError"
      ],
      "properties": {
        "status": {
          "enum": [
            "not-started",
            "researching",
            "researched",
            "publishing",
            "completed",
            "failed"
          ]
        },
        "phase": {
          "type": ["string", "null"],
          "enum": ["research", "publish", null]
        },
        "researchSha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "researchCommit": {
          "type": ["string", "null"],
          "pattern": "^[a-fA-F0-9]{40}$"
        },
        "publishAttempt": { "type": "integer", "minimum": 0 },
        "publishedCommit": {
          "type": ["string", "null"],
          "pattern": "^[a-fA-F0-9]{40}$"
        },
        "completedAt": { "type": ["string", "null"], "format": "date-time" },
        "lastError": {
          "type": ["object", "null"],
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "baselineStatus": { "type": "string", "enum": ["pending", "passed"] },
    "resolutionStatus": { "type": "string", "enum": ["pending", "resolved"] },
    "initialBranch": { "type": ["string", "null"], "minLength": 1 },
    "initialCommit": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" },
    "migrationBranch": {
      "type": ["string", "null"],
      "pattern": "^migration/angular-[0-9]+-to-[0-9]+-[a-f0-9]{8}$"
    },
    "checkpointCommit": {
      "type": ["string", "null"],
      "pattern": "^[a-fA-F0-9]{40}$"
    },
    "manifestSha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "discoverySha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "inputFingerprint": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runtimePlan": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/definitions/runtimePlan" }]
    },
    "runtimeFnmPath": {
      "type": ["string", "null"]
    },
    "activeOperation": {
      "type": ["object", "null"],
      "required": [
        "id",
        "stage",
        "startedAt",
        "checkpointCommit",
        "expectedManifestSha256",
        "preexistingFiles"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "minLength": 1 },
        "startedAt": { "type": "string", "format": "date-time" },
        "checkpointCommit": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40}$"
        },
        "expectedManifestSha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "preexistingFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["status", "path", "untracked"],
            "properties": {
              "status": { "type": "string" },
              "path": { "type": "string", "minLength": 1 },
              "untracked": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "completedOperations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "baseline",
          "resolve-manifest",
          "create-branch",
          "update-angular",
          "update-dependencies",
          "install",
          "validate",
          "technical-result"
        ]
      }
    },
    "skippedChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "checkId",
          "reason",
          "diagnostic",
          "approvedAt",
          "confirmed"
        ],
        "properties": {
          "stage": { "const": "baseline" },
          "checkId": { "enum": ["typecheck", "lint", "unit-test", "e2e"] },
          "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "diagnostic": { "$ref": "#/properties/lastDiagnostic" },
          "approvedAt": { "type": "string", "format": "date-time" },
          "confirmed": { "const": true }
        },
        "additionalProperties": false
      }
    },
    "lastDiagnostic": {
      "type": ["object", "null"],
      "required": ["code", "message", "details"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "details": {}
      },
      "additionalProperties": false
    },
    "repair": {
      "type": ["object", "null"],
      "properties": {
        "context": { "$ref": "repair-context.schema.json" },
        "diagnosticHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "before": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["status", "path", "untracked"],
            "properties": {
              "status": { "type": "string" },
              "path": { "type": "string", "minLength": 1 },
              "untracked": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "protected": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "hash"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "hash": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        },
        "accepted": {
          "type": ["object", "null"],
          "required": [
            "fingerprint",
            "attempt",
            "commit",
            "report",
            "reportSha256"
          ],
          "properties": {
            "fingerprint": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
            "commit": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" },
            "report": {
              "type": "string",
              "pattern": "^\\.angular-migration/runs/[^/]+/repairs/[^/]+\\.json$"
            },
            "reportSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          },
          "additionalProperties": false
        },
        "facadePath": { "type": "string", "minLength": 1 }
      },
      "required": [
        "context",
        "diagnosticHash",
        "before",
        "protected",
        "accepted",
        "facadePath"
      ],
      "additionalProperties": false
    },
    "repairTotal": { "type": "integer", "minimum": 0, "maximum": 5 },
    "repairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fingerprint",
          "attempt",
          "commit",
          "report",
          "reportSha256"
        ],
        "properties": {
          "fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
          "commit": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" },
          "report": {
            "type": "string",
            "pattern": "^\\.angular-migration/runs/[^/]+/repairs/[^/]+\\.json$"
          },
          "reportSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "validationResults": {
      "type": "array",
      "items": { "$ref": "check-result.schema.json" }
    },
    "angularCommandIndex": { "type": "integer", "minimum": 0 },
    "runtimeSha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "configRepairAllowed": { "type": "boolean" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "definitions": {
    "runtimePlan": {
      "type": "object",
      "required": ["profiles", "conflicts", "missingVersions"],
      "properties": {
        "profiles": {
          "type": "array",
          "items": { "$ref": "#/definitions/runtimeProfile" }
        },
        "conflicts": {
          "type": "array",
          "items": { "$ref": "#/definitions/runtimeConflict" }
        },
        "missingVersions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
        }
      },
      "additionalProperties": false
    },
    "runtimeProfile": {
      "type": "object",
      "required": [
        "id",
        "operations",
        "requiredNodeRanges",
        "requiredNpmRange",
        "constraints",
        "selectedNodeVersion",
        "detectedNpmVersion",
        "status"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "operations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "requiredNodeRanges": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "requiredNpmRange": { "type": "string", "minLength": 1 },
        "constraints": {
          "type": "array",
          "items": { "$ref": "#/definitions/runtimeConstraint" }
        },
        "selectedNodeVersion": {
          "type": ["string", "null"],
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "detectedNpmVersion": {
          "type": ["string", "null"],
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "status": { "enum": ["installed", "missing", "blocked"] }
      },
      "additionalProperties": false
    },
    "runtimeConstraint": {
      "type": "object",
      "required": ["source", "value", "reason"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "runtimeConflict": {
      "type": "object",
      "required": ["code", "profileId", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "profileId": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
