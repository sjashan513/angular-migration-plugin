{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Angular migration grouped change ledger",
  "type": "object",
  "required": ["schema_version", "closed", "run", "groups", "summary"],
  "properties": {
    "schema_version": { "const": 1 },
    "closed": { "type": "boolean" },
    "run": {
      "type": "object",
      "required": ["kind", "agent", "started_at"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "agent": { "type": "string", "minLength": 1 },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "source",
          "summary",
          "reason",
          "transformation",
          "occurrences",
          "count"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "source": {
            "type": "string",
            "enum": ["manual", "schematic", "formatter", "linter"]
          },
          "summary": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "transformation": { "type": "object" },
          "occurrences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["file", "location", "status"],
              "properties": {
                "file": { "type": "string", "minLength": 1 },
                "location": { "type": "string", "minLength": 1 },
                "status": {
                  "type": "string",
                  "enum": ["applied", "skipped", "failed"]
                }
              }
            }
          },
          "count": { "type": "integer", "minimum": 1 },
          "validation": { "type": ["object", "null"] },
          "commit": { "type": ["string", "null"] }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["groups", "occurrences", "files"],
      "properties": {
        "groups": { "type": "integer", "minimum": 0 },
        "occurrences": { "type": "integer", "minimum": 0 },
        "files": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
