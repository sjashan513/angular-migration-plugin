{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sjashan513.github.io/angular-migration-plugin/schemas/skip-batch.schema.json",
  "title": "Angular migration baseline skip batch v1",
  "type": "object",
  "required": ["schemaVersion", "runId", "confirmed", "skips"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "confirmed": { "type": "boolean", "const": true },
    "skips": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["checkId", "reason"],
        "properties": {
          "checkId": {
            "type": "string",
            "enum": ["typecheck", "lint", "unit-test", "e2e"]
          },
          "reason": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
