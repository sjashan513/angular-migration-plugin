{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sjashan513.github.io/angular-migration-plugin/schemas/result.schema.json",
  "title": "Angular migration result v5",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "sourceMajor",
    "targetMajor",
    "status",
    "migrationStatus",
    "documentationStatus",
    "manifestSha256",
    "initialCommit",
    "finalTechnicalCommit",
    "changedFiles",
    "dependencyChanges",
    "checks",
    "repairs",
    "warnings",
    "verifiedAt",
    "resultSha256"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [5] },
    "runId": { "type": "string", "minLength": 1 },
    "sourceMajor": { "type": "integer", "minimum": 0 },
    "targetMajor": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["verified"] },
    "migrationStatus": {
      "type": "string",
      "enum": ["pending", "running", "verified", "failed", "blocked"]
    },
    "documentationStatus": {
      "type": "string",
      "enum": ["pending", "researching", "completed", "failed"]
    },
    "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "initialCommit": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" },
    "finalTechnicalCommit": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{40}$"
    },
    "changedFiles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "dependencyChanges": {
      "type": "array",
      "items": { "$ref": "change-set.schema.json" }
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "check-result.schema.json" }
    },
    "repairs": { "type": "array" },
    "warnings": { "type": "array" },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "resultSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
