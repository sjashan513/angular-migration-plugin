{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sjashan513.github.io/angular-migration-plugin/schemas/manifest.schema.json",
  "title": "Angular migration manifest v5",
  "type": "object",
  "required": [
    "schemaVersion",
    "manifestType",
    "runId",
    "createdAt",
    "sourceMajor",
    "targetMajor",
    "resolutionStatus",
    "resolverVersion",
    "project",
    "angular",
    "dependencies",
    "warnings",
    "policies",
    "authorizedOperations",
    "policy",
    "checks",
    "discoverySha256",
    "inputFingerprint",
    "runtimePlan"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [5] },
    "manifestType": { "type": "string", "enum": ["migration"] },
    "runId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "sourceMajor": { "type": "integer", "minimum": 0 },
    "targetMajor": { "type": "integer", "minimum": 1 },
    "resolutionStatus": { "type": "string", "enum": ["pending", "resolved"] },
    "resolverVersion": { "type": "integer", "const": 1 },
    "discoverySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "inputFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runtimePlan": { "$ref": "#/definitions/runtimePlan" },
    "policies": { "$ref": "#/definitions/policies" },
    "authorizedOperations": { "$ref": "#/definitions/authorizedOperations" },
    "node": { "$ref": "#/definitions/node" },
    "resolvedAt": { "type": "string", "format": "date-time" },
    "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "project": {
      "type": "object",
      "required": [
        "name",
        "root",
        "packageManager",
        "files",
        "lockfileVersion",
        "scripts",
        "builders",
        "toolchain",
        "runtimeToolchain",
        "git"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "root": { "type": "string", "minLength": 1 },
        "packageManager": { "type": "string", "const": "npm" },
        "files": {
          "type": "object",
          "required": [
            "packageJson",
            "angularJson",
            "packageLock",
            "tsconfig",
            "configurations"
          ],
          "properties": {
            "packageJson": { "type": "boolean" },
            "angularJson": { "type": "boolean" },
            "packageLock": { "type": "boolean" },
            "tsconfig": { "type": "boolean" },
            "configurations": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "lockfileVersion": { "type": "integer", "enum": [1, 2, 3] },
        "scripts": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "builders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["project", "target", "builder"],
            "properties": {
              "project": { "type": "string", "minLength": 1 },
              "target": { "type": "string", "minLength": 1 },
              "builder": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "toolchain": {
          "type": "object",
          "required": ["node", "npm", "errors"],
          "properties": {
            "node": { "$ref": "#/definitions/tool" },
            "npm": { "$ref": "#/definitions/tool" },
            "errors": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "runtimeToolchain": {
          "type": "object",
          "required": ["fnm"],
          "properties": {
            "fnm": {
              "type": "object",
              "required": ["available", "executable", "version"],
              "properties": {
                "available": { "type": "boolean" },
                "executable": { "type": ["string", "null"] },
                "version": { "type": ["string", "null"] }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "git": {
          "type": "object",
          "required": ["branch", "initialCommit"],
          "properties": {
            "branch": { "type": "string", "minLength": 1 },
            "initialCommit": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{40}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "angular": {
      "type": "object",
      "required": [
        "declaredCoreSpec",
        "resolvedCoreVersion",
        "current",
        "target"
      ],
      "properties": {
        "declaredCoreSpec": { "type": "string", "minLength": 1 },
        "resolvedCoreVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "current": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "target": {
          "type": "object",
          "required": ["major", "resolved", "resolutionStatus"],
          "properties": {
            "major": { "type": "integer", "minimum": 1 },
            "resolved": { "type": "boolean" },
            "resolutionStatus": { "enum": ["pending", "resolved"] },
            "coreVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["name", "section", "role", "spec", "kind"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "section": {
                "enum": [
                  "dependencies",
                  "devDependencies",
                  "optionalDependencies",
                  "peerDependencies"
                ]
              },
              "role": { "enum": ["runtime", "dev", "optional", "peer"] },
              "spec": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "enum": ["registry"] }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "name",
              "section",
              "role",
              "kind",
              "declaredSpec",
              "currentVersion",
              "targetVersion",
              "writeSpec",
              "change",
              "reason",
              "metadata"
            ],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "section": {
                "enum": [
                  "dependencies",
                  "devDependencies",
                  "optionalDependencies",
                  "peerDependencies"
                ]
              },
              "role": {
                "enum": [
                  "angular-framework",
                  "angular-tooling",
                  "toolchain-related",
                  "registry-ordinary",
                  "angular-aware-external"
                ]
              },
              "kind": { "type": "string", "enum": ["registry"] },
              "declaredSpec": { "type": ["string", "null"] },
              "currentVersion": { "type": ["string", "null"] },
              "targetVersion": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "writeSpec": { "type": ["string", "null"] },
              "change": {
                "type": "string",
                "enum": [
                  "unchanged",
                  "minor-or-patch",
                  "major-required",
                  "added-required-tooling"
                ]
              },
              "reason": { "type": "string", "minLength": 1 },
              "metadata": { "$ref": "#/definitions/metadata" }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "node": {
      "type": "object",
      "required": ["activeVersion", "requiredRange", "compatible"],
      "properties": {
        "activeVersion": { "type": "string", "minLength": 1 },
        "requiredRange": { "type": "string", "minLength": 1 },
        "compatible": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "policies": {
      "type": "object",
      "properties": {
        "peerDependenciesMeta": { "type": "object" },
        "overrides": { "type": "object" },
        "peerExceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "package",
              "version",
              "ignoredPeers",
              "reason",
              "scope"
            ],
            "properties": {
              "package": { "type": "string", "minLength": 1 },
              "version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "ignoredPeers": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "scope": { "const": "run" }
            },
            "additionalProperties": false
          }
        },
        "transitivePeerPromotions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["package", "section", "reason"],
            "properties": {
              "package": { "type": "string", "minLength": 1 },
              "section": { "enum": ["dependencies", "devDependencies"] },
              "reason": { "type": "string", "minLength": 1, "maxLength": 2000 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "authorizedOperations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "resolve-manifest",
          "update-angular",
          "update-dependencies",
          "install",
          "dependency-tree",
          "typecheck",
          "lint",
          "unit-test",
          "build",
          "e2e",
          "skip-check",
          "skip-checks"
        ]
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "sequentialMajor",
        "exactManifestVersions",
        "allowForce",
        "allowDirty",
        "allowLegacyPeerDeps"
      ],
      "properties": {
        "sequentialMajor": { "type": "boolean" },
        "exactManifestVersions": { "type": "boolean" },
        "allowForce": { "type": "boolean", "const": false },
        "allowDirty": { "type": "boolean", "const": false },
        "allowLegacyPeerDeps": { "type": "boolean", "const": false }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "id",
          "phase",
          "status",
          "blocking",
          "executable",
          "arguments",
          "displayCommand",
          "cwd",
          "timeoutSeconds",
          "reason",
          "canSkip",
          "runtimeProfile"
        ],
        "properties": {
          "id": {
            "enum": [
              "install",
              "dependency-tree",
              "typecheck",
              "lint",
              "unit-test",
              "build",
              "e2e"
            ]
          },
          "phase": { "const": "baseline" },
          "status": { "enum": ["configured", "not-configured", "blocked"] },
          "blocking": { "const": true },
          "executable": { "enum": ["npm", null] },
          "arguments": { "type": "array", "items": { "type": "string" } },
          "displayCommand": { "type": ["string", "null"] },
          "cwd": { "type": "string", "minLength": 1 },
          "timeoutSeconds": {
            "type": "integer",
            "enum": [300, 600, 900, 1200, 1800]
          },
          "reason": { "type": ["string", "null"] },
          "canSkip": { "type": "boolean" },
          "runtimeProfile": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["code", "package", "peer", "range"],
            "properties": {
              "code": { "const": "optional_peer_missing" },
              "package": { "type": "string", "minLength": 1 },
              "peer": { "type": "string", "minLength": 1 },
              "range": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["code", "package", "fromMajor", "toMajor"],
            "properties": {
              "code": { "const": "package_major_changed_for_angular" },
              "package": { "type": "string", "minLength": 1 },
              "fromMajor": { "type": "integer", "minimum": 0 },
              "toMajor": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["code", "package", "version", "reason"],
            "properties": {
              "code": { "const": "deprecated_ordinary_dependency" },
              "package": { "type": "string", "minLength": 1 },
              "version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "reason": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["code", "package", "peer", "range", "reason"],
            "properties": {
              "code": { "const": "ignored_peer_dependency" },
              "package": { "type": "string", "minLength": 1 },
              "peer": { "type": "string", "minLength": 1 },
              "range": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "definitions": {
    "tool": {
      "type": "object",
      "required": ["available", "executable", "version", "stdout"],
      "properties": {
        "available": { "type": "boolean" },
        "executable": { "type": ["string", "null"], "minLength": 1 },
        "version": { "type": ["string", "null"], "minLength": 1 },
        "stdout": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": [
        "source",
        "selector",
        "retrievedAt",
        "deprecated",
        "peerDependencies",
        "peerDependenciesMeta",
        "engines",
        "ngUpdate",
        "distTags"
      ],
      "properties": {
        "source": { "type": "string", "const": "npm-view" },
        "selector": { "type": "string", "minLength": 1 },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "deprecated": { "type": "boolean" },
        "peerDependencies": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "peerDependenciesMeta": {
          "type": "object",
          "additionalProperties": { "type": "object" }
        },
        "engines": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "ngUpdate": { "type": ["object", "array", "string", "null"] },
        "distTags": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "runtimePlan": {
      "type": "object",
      "required": ["profiles", "conflicts", "missingVersions"],
      "properties": {
        "profiles": {
          "type": "array",
          "items": { "$ref": "#/definitions/runtimeProfile" }
        },
        "conflicts": {
          "type": "array",
          "items": { "$ref": "#/definitions/runtimeConflict" }
        },
        "missingVersions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
        }
      },
      "additionalProperties": false
    },
    "runtimeProfile": {
      "type": "object",
      "required": [
        "id",
        "operations",
        "requiredNodeRanges",
        "requiredNpmRange",
        "constraints",
        "selectedNodeVersion",
        "detectedNpmVersion",
        "status"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "operations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "requiredNodeRanges": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "requiredNpmRange": { "type": "string", "minLength": 1 },
        "constraints": {
          "type": "array",
          "items": { "$ref": "#/definitions/runtimeConstraint" }
        },
        "selectedNodeVersion": {
          "type": ["string", "null"],
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "detectedNpmVersion": {
          "type": ["string", "null"],
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "status": { "enum": ["installed", "missing", "blocked"] }
      },
      "additionalProperties": false
    },
    "runtimeConstraint": {
      "type": "object",
      "required": ["source", "value", "reason"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "runtimeConflict": {
      "type": "object",
      "required": ["code", "profileId", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "profileId": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "resolutionStatus": { "const": "resolved" } } },
      "then": {
        "required": ["resolvedAt", "node", "manifestSha256"],
        "properties": {
          "dependencies": {
            "items": {
              "required": [
                "name",
                "section",
                "role",
                "kind",
                "declaredSpec",
                "currentVersion",
                "targetVersion",
                "writeSpec",
                "change",
                "reason",
                "metadata"
              ]
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
