{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sjashan513.github.io/angular-migration-plugin/schemas/manifest.schema.json",
  "title": "Angular migration manifest v5",
  "type": "object",
  "required": [
    "schemaVersion",
    "manifestType",
    "runId",
    "sourceMajor",
    "targetMajor",
    "resolutionStatus",
    "resolverVersion",
    "project",
    "angular",
    "dependencies",
    "warnings",
    "policy",
    "checks"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [5] },
    "manifestType": { "type": "string", "enum": ["migration"] },
    "runId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "sourceMajor": { "type": "integer", "minimum": 0 },
    "targetMajor": { "type": "integer", "minimum": 1 },
    "resolutionStatus": { "type": "string", "enum": ["pending", "resolved"] },
    "resolverVersion": { "type": "integer", "const": 1 },
    "resolvedAt": { "type": "string", "format": "date-time" },
    "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "project": { "type": "object" },
    "angular": {
      "type": "object",
      "required": [
        "declaredCoreSpec",
        "resolvedCoreVersion",
        "current",
        "target"
      ],
      "properties": {
        "declaredCoreSpec": { "type": "string", "minLength": 1 },
        "resolvedCoreVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "current": { "type": "object" },
        "target": { "type": "object" }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "section": {
            "enum": [
              "dependencies",
              "devDependencies",
              "optionalDependencies",
              "peerDependencies"
            ]
          },
          "role": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["registry"] },
          "declaredSpec": { "type": ["string", "null"] },
          "currentVersion": { "type": ["string", "null"] },
          "targetVersion": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "writeSpec": { "type": ["string", "null"] },
          "change": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "metadata": { "type": "object" }
        }
      }
    },
    "node": {
      "type": "object",
      "required": ["activeVersion", "requiredRange", "compatible"],
      "properties": {
        "activeVersion": { "type": "string", "minLength": 1 },
        "requiredRange": { "type": "string", "minLength": 1 },
        "compatible": { "type": "boolean" }
      }
    },
    "policies": { "type": "object" },
    "authorizedOperations": { "type": "array", "items": { "type": "string" } },
    "policy": {
      "type": "object",
      "required": [
        "sequentialMajor",
        "exactManifestVersions",
        "allowForce",
        "allowDirty",
        "allowLegacyPeerDeps"
      ],
      "properties": {
        "sequentialMajor": { "type": "boolean" },
        "exactManifestVersions": { "type": "boolean" },
        "allowForce": { "type": "boolean", "const": false },
        "allowDirty": { "type": "boolean", "const": false },
        "allowLegacyPeerDeps": { "type": "boolean", "const": false }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "id",
          "phase",
          "status",
          "blocking",
          "executable",
          "arguments",
          "displayCommand",
          "cwd",
          "timeoutSeconds",
          "reason"
        ],
        "properties": {
          "id": {
            "enum": [
              "install",
              "dependency-tree",
              "typecheck",
              "lint",
              "unit-test",
              "build",
              "e2e"
            ]
          },
          "phase": { "const": "baseline" },
          "status": { "enum": ["configured", "not-configured", "blocked"] },
          "blocking": { "const": true },
          "executable": { "enum": ["npm", null] },
          "arguments": { "type": "array", "items": { "type": "string" } },
          "displayCommand": { "type": ["string", "null"] },
          "cwd": { "type": "string", "minLength": 1 },
          "timeoutSeconds": {
            "type": "integer",
            "enum": [300, 600, 900, 1200, 1800]
          },
          "reason": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "warnings": { "type": "array" }
  },
  "allOf": [
    {
      "if": { "properties": { "resolutionStatus": { "const": "resolved" } } },
      "then": {
        "required": ["resolvedAt", "node", "manifestSha256"],
        "properties": {
          "dependencies": {
            "items": {
              "required": [
                "name",
                "section",
                "role",
                "kind",
                "declaredSpec",
                "currentVersion",
                "targetVersion",
                "writeSpec",
                "change",
                "reason",
                "metadata"
              ]
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
