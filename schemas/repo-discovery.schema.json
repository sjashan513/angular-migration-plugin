{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sjashan513.github.io/angular-migration-plugin/schemas/repo-discovery.schema.json",
  "title": "Angular migration repository discovery v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "discoveryType",
    "projectRoot",
    "projectName",
    "sourceMajor",
    "targetMajor",
    "status",
    "discoveredAt",
    "inputFingerprint",
    "toolchain",
    "repository",
    "runtimePlan",
    "installProposal",
    "warnings",
    "repoSha256"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "discoveryType": {
      "type": "string",
      "const": "angular-migration-repository"
    },
    "projectRoot": { "type": "string", "minLength": 1 },
    "projectName": { "type": "string", "minLength": 1 },
    "sourceMajor": { "type": "integer", "minimum": 0 },
    "targetMajor": { "type": "integer", "minimum": 1 },
    "status": {
      "type": "string",
      "enum": ["ready", "runtime-install-required", "blocked", "failed"]
    },
    "discoveredAt": { "type": "string", "format": "date-time" },
    "inputFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "toolchain": { "$ref": "#/definitions/toolchain" },
    "repository": { "$ref": "#/definitions/repository" },
    "runtimePlan": { "$ref": "#/definitions/runtimePlan" },
    "installProposal": {
      "anyOf": [{ "$ref": "#/definitions/installProposal" }, { "type": "null" }]
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/definitions/warning" }
    },
    "repoSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "definitions": {
    "toolchain": {
      "type": "object",
      "required": ["fnm", "installedNodeVersions", "identities"],
      "properties": {
        "fnm": { "$ref": "#/definitions/fnm" },
        "installedNodeVersions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
        },
        "identities": {
          "type": "array",
          "items": { "$ref": "#/definitions/runtimeIdentity" }
        }
      },
      "additionalProperties": false
    },
    "fnm": {
      "type": "object",
      "required": ["available", "executable", "version"],
      "properties": {
        "available": { "type": "boolean" },
        "executable": { "type": ["string", "null"], "minLength": 1 },
        "version": { "type": ["string", "null"], "minLength": 1 }
      },
      "additionalProperties": false
    },
    "runtimeIdentity": {
      "type": "object",
      "required": ["nodeVersion", "npmVersion", "status"],
      "properties": {
        "nodeVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "npmVersion": {
          "type": ["string", "null"],
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "status": { "type": "string", "enum": ["usable", "unusable"] },
        "reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": [
        "angular",
        "packageManager",
        "lockfileVersion",
        "scripts",
        "checks",
        "files",
        "dependencies",
        "nodeDeclarations",
        "angularRuntime",
        "npmRequirements",
        "tooling",
        "risks"
      ],
      "properties": {
        "angular": { "$ref": "#/definitions/angular" },
        "packageManager": { "type": "string", "const": "npm" },
        "lockfileVersion": {
          "type": ["integer", "null"],
          "enum": [1, 2, 3, null]
        },
        "scripts": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/definitions/check" }
        },
        "files": {
          "type": "array",
          "items": { "$ref": "#/definitions/fileFinding" }
        },
        "dependencies": {
          "type": "array",
          "items": { "$ref": "#/definitions/dependency" }
        },
        "nodeDeclarations": {
          "type": "array",
          "items": { "$ref": "#/definitions/declaration" }
        },
        "angularRuntime": {
          "type": "object",
          "required": ["source", "target"],
          "properties": {
            "source": {
              "type": "array",
              "items": { "$ref": "#/definitions/packageRuntime" }
            },
            "target": {
              "type": "array",
              "items": { "$ref": "#/definitions/packageRuntime" }
            }
          },
          "additionalProperties": false
        },
        "npmRequirements": {
          "type": "object",
          "required": ["minimumRange", "source"],
          "properties": {
            "minimumRange": { "type": "string", "minLength": 1 },
            "source": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "tooling": {
          "type": "array",
          "items": { "$ref": "#/definitions/tooling" }
        },
        "risks": {
          "type": "array",
          "items": { "$ref": "#/definitions/risk" }
        }
      },
      "additionalProperties": false
    },
    "angular": {
      "type": "object",
      "required": ["declaredCoreSpec", "resolvedCoreVersion", "projects"],
      "properties": {
        "declaredCoreSpec": { "type": ["string", "null"] },
        "resolvedCoreVersion": { "type": ["string", "null"] },
        "projects": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": [
        "id",
        "status",
        "blocking",
        "canSkip",
        "executable",
        "arguments",
        "displayCommand",
        "cwd",
        "timeoutSeconds",
        "reason",
        "runtimeProfile"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "install",
            "dependency-tree",
            "typecheck",
            "lint",
            "unit-test",
            "build",
            "e2e"
          ]
        },
        "status": {
          "type": "string",
          "enum": ["configured", "not-configured", "blocked"]
        },
        "blocking": { "type": "boolean", "const": true },
        "canSkip": { "type": "boolean" },
        "executable": { "type": ["string", "null"], "enum": ["npm", null] },
        "arguments": { "type": "array", "items": { "type": "string" } },
        "displayCommand": { "type": ["string", "null"] },
        "cwd": { "type": "string", "minLength": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "reason": { "type": ["string", "null"] },
        "runtimeProfile": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "fileFinding": {
      "type": "object",
      "required": ["path", "present", "kind"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "present": { "type": "boolean" },
        "kind": {
          "type": "string",
          "enum": ["required", "configuration", "declaration", "lockfile"]
        }
      },
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "required": ["name", "section", "declaredSpec", "lockedVersion", "kind"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "section": {
          "type": "string",
          "enum": [
            "dependencies",
            "devDependencies",
            "optionalDependencies",
            "peerDependencies"
          ]
        },
        "declaredSpec": { "type": "string", "minLength": 1 },
        "lockedVersion": { "type": ["string", "null"] },
        "kind": {
          "type": "string",
          "enum": ["runtime", "dev", "optional", "peer"]
        }
      },
      "additionalProperties": false
    },
    "declaration": {
      "type": "object",
      "required": ["source", "value", "kind"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["node", "npm"] }
      },
      "additionalProperties": false
    },
    "packageRuntime": {
      "type": "object",
      "required": ["name", "version", "nodeRange"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "nodeRange": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "tooling": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "risk": {
      "type": "object",
      "required": ["code", "severity", "mitigated", "reason"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["warning", "blocking"] },
        "mitigated": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "runtimePlan": {
      "type": "object",
      "required": ["profiles", "conflicts", "missingVersions"],
      "properties": {
        "profiles": {
          "type": "array",
          "items": { "$ref": "#/definitions/profile" }
        },
        "conflicts": {
          "type": "array",
          "items": { "$ref": "#/definitions/conflict" }
        },
        "missingVersions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
        }
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": [
        "id",
        "operations",
        "requiredNodeRanges",
        "requiredNpmRange",
        "constraints",
        "selectedNodeVersion",
        "detectedNpmVersion",
        "status"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "operations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "requiredNodeRanges": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "requiredNpmRange": { "type": "string", "minLength": 1 },
        "constraints": {
          "type": "array",
          "items": { "$ref": "#/definitions/constraint" }
        },
        "selectedNodeVersion": {
          "type": ["string", "null"],
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "detectedNpmVersion": {
          "type": ["string", "null"],
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "status": {
          "type": "string",
          "enum": ["installed", "missing", "blocked"]
        }
      },
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "required": ["source", "value", "reason"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "conflict": {
      "type": "object",
      "required": ["code", "profileId", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "profileId": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "installProposal": {
      "type": "object",
      "required": [
        "schemaVersion",
        "projectRoot",
        "targetMajor",
        "inputFingerprint",
        "versions",
        "proposalHash"
      ],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "projectRoot": { "type": "string", "minLength": 1 },
        "targetMajor": { "type": "integer", "minimum": 1 },
        "inputFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "versions": {
          "type": "array",
          "items": { "$ref": "#/definitions/proposalVersion" }
        },
        "proposalHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "proposalVersion": {
      "type": "object",
      "required": ["version", "profiles", "reasons"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "warning": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
