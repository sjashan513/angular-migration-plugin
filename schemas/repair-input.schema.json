{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "fingerprint",
    "attempt",
    "rootCause",
    "changes",
    "evidence",
    "unresolvedWarnings"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "runId": { "type": "string", "pattern": "^[a-z0-9TZ]+(?:-[a-z0-9TZ]+)*$" },
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
    "rootCause": { "type": "string", "pattern": "\\S" },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "summary", "reason"],
        "properties": {
          "path": { "type": "string", "pattern": "\\S" },
          "summary": { "type": "string", "pattern": "\\S" },
          "reason": { "type": "string", "pattern": "\\S" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "reference", "claim"],
        "properties": {
          "kind": { "type": "string", "enum": ["diagnostic"] },
          "reference": { "type": "string", "pattern": "\\S" },
          "claim": { "type": "string", "pattern": "\\S" }
        }
      }
    },
    "unresolvedWarnings": {
      "type": "array",
      "items": { "type": "string", "pattern": "\\S" }
    }
  }
}
