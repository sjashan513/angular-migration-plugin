{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sjashan513.github.io/angular-migration-plugin/schemas/documentation-context.schema.json",
  "title": "Angular migration documentation context v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "mode",
        "runId",
        "sourceMajor",
        "targetMajor",
        "manifestSha256",
        "dependencies",
        "questions",
        "allowedWritePath"
      ],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "mode": { "type": "string", "const": "research" },
        "runId": {
          "type": "string",
          "pattern": "^[a-z0-9TZ]+(?:-[a-z0-9TZ]+)*$"
        },
        "sourceMajor": { "type": "integer", "minimum": 0 },
        "targetMajor": { "type": "integer", "minimum": 1 },
        "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "currentVersion",
              "targetVersion",
              "change",
              "reason"
            ],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "currentVersion": { "type": ["string", "null"] },
              "targetVersion": { "type": ["string", "null"] },
              "change": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "allowedWritePath": {
          "type": "string",
          "pattern": "^\\.angular-migration/runs/[a-z0-9TZ-]+/inbox/research\\.json$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "mode",
        "runId",
        "sourceMajor",
        "targetMajor",
        "migrationStatus",
        "manifestSha256",
        "researchSha256",
        "technicalVerifiedCommit",
        "outputDirectory",
        "requiredFiles",
        "evidence",
        "submissionPath"
      ],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "mode": { "type": "string", "const": "publish" },
        "runId": {
          "type": "string",
          "pattern": "^[a-z0-9TZ]+(?:-[a-z0-9TZ]+)*$"
        },
        "sourceMajor": { "type": "integer", "minimum": 0 },
        "targetMajor": { "type": "integer", "minimum": 1 },
        "migrationStatus": { "type": "string", "const": "verified" },
        "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "researchSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "technicalVerifiedCommit": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40}$"
        },
        "outputDirectory": {
          "type": "string",
          "pattern": "^docs/migration/v[0-9]+$"
        },
        "requiredFiles": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "manifest",
            "result",
            "research",
            "events",
            "repairs",
            "repairHistory"
          ],
          "properties": {
            "manifest": { "type": "string", "minLength": 1 },
            "result": { "type": "string", "minLength": 1 },
            "research": { "type": "string", "minLength": 1 },
            "events": { "type": "string", "minLength": 1 },
            "repairs": { "type": "string", "minLength": 1 },
            "repairHistory": {
              "type": "string",
              "pattern": "^\\.angular-migration/runs/[a-z0-9TZ-]+/repair-history$"
            }
          }
        },
        "submissionPath": {
          "type": "string",
          "pattern": "^\\.angular-migration/runs/[a-z0-9TZ-]+/inbox/documentation\\.json$"
        }
      }
    }
  ]
}
